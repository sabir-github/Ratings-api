      {
        "id": "expression-3c4d5e6f-calc",
        "type": "expression",
        "label": "Rating Expressions",
        "data": {
          "stepType": "expression",
          "label": "Rating Expressions",
          "collapsed": true,
          "stepOrder": 3,
          "expressions": [
            { "expression": "(iprPPLocal * oprRatePPLocal) + (iprPPLong * oprRatePPLong)", "outputVariable": "opexVehiclePremiumPP" },
            { "expression": "(iprLtLocal * oprRateLtLocal) + (iprLtLong * oprRateLtLong)", "outputVariable": "opexVehiclePremiumLt" },
            { "expression": "(iprMtLocal * oprRateMtLocal) + (iprMtLong * oprRateMtLong)", "outputVariable": "opexVehiclePremiumMt" },
            { "expression": "(iprHyLocal * oprRateHyLocal) + (iprHyLong * oprRateHyLong)", "outputVariable": "opexVehiclePremiumHy" },
            { "expression": "(iprEHyLocal * oprRateEHyLocal) + (iprEHyLong * oprRateEHyLong)", "outputVariable": "opexVehiclePremiumEHy" },
            { "expression": "(iprOtLocal * oprRateOtLocal) + (iprOtLong * oprRateOtLong)", "outputVariable": "opexVehiclePremiumOt" },
            { "expression": "opexVehiclePremiumPP + opexVehiclePremiumLt + opexVehiclePremiumMt + opexVehiclePremiumHy + opexVehiclePremiumEHy + opexVehiclePremiumOt", "outputVariable": "opexTotalAutoBasePremium" },
            { "expression": "iprLocations * oprBaseAddlLoc", "outputVariable": "opexAddlLocationsPremium" },
            { "expression": "oprBaseMillion + opexAddlLocationsPremium + opexTotalAutoBasePremium", "outputVariable": "oprexTotalBasePremium" },
            { "expression": "oprexTotalBasePremium * oprStateFactor * oprProgramFactor * oprHazardFactor * oprDistSysCredit * oprFranchiseFactor * oprCreditScoreFactor", "outputVariable": "oprexRatingFactorProduct" },
            { "expression": "MAX(oprMinPremium1M, oprexRatingFactorProduct * oprSIRFactor)", "outputVariable": "oprexPremiumAt1M" },
            { "expression": "IF(iprLimit == 1000000, oprexPremiumAt1M, MAX(oprMinPremiumIncrementSelected + oprexPremiumAt1M, oprexRatingFactorProduct * oprILF * oprSIRFactor))", "outputVariable": "oprexPremiumAtSelectedLimit" }
          ]
        },
