        "data": {
          "stepType": "quote_output",
          "label": "Div 67 Umbrella - Quote Output",
          "collapsed": true,
          "stepOrder": 4,
          "outputs": [
            {
              "expression": "totalBasePremium",
              "formatTemplate": "Total Base Premium: ${value}"
            },
            {
              "expression": "chargedPremium",
              "formatTemplate": "Charged Premium: ${value}"
            }
          ]
        },
        "position": {
          "x": 1200.0,
          "y": 0.0
        }
      }
