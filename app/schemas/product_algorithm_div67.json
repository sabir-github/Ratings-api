              "fieldMappings": [
                {
                  "tableField": "Grade",
                  "variableName": "hazardGrade",
                  "valueSource": "variable",
                  "compareOperator": "eq"
                }
              ],
              "outputField": "Relativities",
              "interpolationMode": "exact",
              "outputVariable": "hazardGradeFactor"
            },
            {
