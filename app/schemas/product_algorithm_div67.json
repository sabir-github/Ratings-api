      {
        "id": "step-3",
        "type": "expression",
        "label": "Div 67 Umbrella - Premium Calculation",
        "data": {
          "stepType": "expression",
          "label": "Div 67 Umbrella - Premium Calculation",
          "collapsed": true,
          "stepOrder": 3,
          "expressions": [
            {
              "expression": "numAdditionalLocations * 35",
              "outputVariable": "basePremiumAddlLocations"
            },
            {
              "expression": "rateLocalPPType * 1.5",
              "outputVariable": "rateLongPPType"
            },
            {
              "expression": "rateLocalLightTruck * 1.5",
              "outputVariable": "rateLongLightTruck"
            },
            {
              "expression": "rateLocalMediumTruck * 1.5",
              "outputVariable": "rateLongMediumTruck"
            },
            {
              "expression": "rateLocalExtraHeavy * 2",
              "outputVariable": "rateLongExtraHeavy"
            },
            {
              "expression": "rateLocalHeavy * 2",
              "outputVariable": "rateLongHeavy"
            },
            {
              "expression": "rateLocalAllOther * 2",
              "outputVariable": "rateLongAllOther"
            },
            {
              "expression": "qtyPPTypeLocal * rateLocalPPType + qtyPPTypeLongDistance * rateLongPPType",
              "outputVariable": "premiumPPType"
            },
            {
              "expression": "qtyLightTruckLocal * rateLocalLightTruck + qtyLightTruckLongDistance * rateLongLightTruck",
              "outputVariable": "premiumLightTruck"
            },
            {
              "expression": "qtyMediumTruckLocal * rateLocalMediumTruck + qtyMediumTruckLongDistance * rateLongMediumTruck",
              "outputVariable": "premiumMediumTruck"
            },
            {
              "expression": "qtyExtraHeavyLocal * rateLocalExtraHeavy + qtyExtraHeavyLongDistance * rateLongExtraHeavy",
              "outputVariable": "premiumExtraHeavy"
            },
            {
              "expression": "qtyHeavyLocal * rateLocalHeavy + qtyHeavyLongDistance * rateLongHeavy",
              "outputVariable": "premiumHeavy"
            },
            {
              "expression": "qtyAllOtherLocal * rateLocalAllOther + qtyAllOtherLongDistance * rateLongAllOther",
              "outputVariable": "premiumAllOther"
            },
            {
              "expression": "premiumPPType + premiumLightTruck + premiumMediumTruck + premiumExtraHeavy + premiumHeavy + premiumAllOther",
              "outputVariable": "totalAutoBasePremium"
            },
            {
              "expression": "totalAutoBasePremium + basePremiumAddlLocations + 350",
              "outputVariable": "totalBasePremium"
            },
            {
              "expression": "distSystemCredit == 'Agency' ? 1 : distSystemERCFactor",
              "outputVariable": "distSystemCreditFactor"
            },
            {
              "expression": "stateOfDomicile == 'NJ' ? 1 : creditScoreFactor",
              "outputVariable": "creditScoreFactorFinal"
            },
            {
              "expression": "totalBasePremium * stateFactor * programFactor * hazardGradeFactor * distSystemCreditFactor * franchiseCreditFactor * creditScoreFactorFinal",
              "outputVariable": "factorProduct"
            },
            {
              "expression": "max(minimumPremium1M, factorProduct * sirFactorZero)",
              "outputVariable": "premiumAt1M_Zero",
              "runCondition": "coveragePartPurchased == 'Yes'"
            },
            {
              "expression": "max(minimumPremium1M, factorProduct * sirFactor10000)",
              "outputVariable": "premiumAt1M_10000",
              "runCondition": "coveragePartPurchased == 'Yes'"
            },
            {
              "expression": "selfInsuredRetention == '10000' ? sirFactor10000 : sirFactorZero",
              "outputVariable": "selectedSIRFactor",
              "runCondition": "coveragePartPurchased == 'Yes'"
            },
            {
              "expression": "selfInsuredRetention == '10000' ? premiumAt1M_10000 : premiumAt1M_Zero",
              "outputVariable": "premiumAt1M_Selected",
              "runCondition": "coveragePartPurchased == 'Yes'"
            },
            {
              "expression": "umbrellaLimit == 1000000 ? premiumAt1M_Selected : max(minimumPremiumSelected + premiumAt1M_Selected, factorProduct * increasedLimitsFactor * selectedSIRFactor)",
              "outputVariable": "ratedPremiumAtSelectedLimit",
              "runCondition": "coveragePartPurchased == 'Yes'"
            },
            {
              "expression": "coveragePartPurchased == 'No' ? 0 : ratedPremiumAtSelectedLimit",
              "outputVariable": "chargedPremium"
            }
          ]
        },
        "position": {
          "x": 800.0,
          "y": 0.0
        }
      },
