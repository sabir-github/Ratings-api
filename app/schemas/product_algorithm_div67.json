              "fieldMappings": [
                {
                  "tableField": "Credit Score",
                  "variableName": "creditScore",
                  "valueSource": "variable",
                  "compareOperator": "eq"
                }
              ],
              "outputField": "Factor",
              "interpolationMode": "exact",
              "outputVariable": "creditScoreFactor",
              "runCondition": "stateOfDomicile != 'NJ'"
