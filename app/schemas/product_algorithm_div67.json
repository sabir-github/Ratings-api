            },
            {
              "tableName": "Table 11 - Minimum Premium",
              "fieldMappings": [
                {
                  "tableField": "Limit",
                  "variableName": "",
                  "valueSource": "literal",
                  "compareOperator": "eq",
                  "literalValue": "1000000"
                }
              ],
              "outputField": "Minimum Premium",
              "interpolationMode": "exact",
              "outputVariable": "minimumPremium1M",
              "runCondition": "coveragePartPurchased == 'Yes'"
