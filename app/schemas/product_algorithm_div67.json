              "outputVariable": "rateLocalHeavy"
            },
            {
              "tableName": "Table 8 - Auto Factors (Local & Medium)",
              "fieldMappings": [
                {
                  "tableField": "Vehicle Type",
                  "variableName": "",
                  "valueSource": "literal",
                  "compareOperator": "eq",
                  "literalValue": "f. All Other"
                }
              ],
              "outputField": "Rate",
              "interpolationMode": "exact",
